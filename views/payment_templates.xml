<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="payment_ebioro" name="Ebioro Payment Form" inherit_id="payment.payment_form">
        <xpath expr="//div[@id='payment_method']" position="replace">
            <div id="payment_method" t-if="provider_code == 'ebioro'">
                <div class="alert alert-info" role="alert">
                    You will be redirected to Ebioro to complete your payment.
                </div>
                
                <form t-attf-action="{{ tx_values['return_url'] }}" method="post" id="ebioro_payment_form">
                    <input type="hidden" name="public_key" t-att-value="tx_values['public_key']"/>
                    <input type="hidden" name="amount" t-att-value="tx_values['amount']"/>
                    <input type="hidden" name="currency" t-att-value="tx_values['currency']"/>
                    <input type="hidden" name="reference" t-att-value="tx_values['reference']"/>
                    <input type="hidden" name="partner_name" t-att-value="tx_values['partner_name']"/>
                    <input type="hidden" name="partner_email" t-att-value="tx_values['partner_email']"/>
                    <input type="hidden" name="webhook_url" t-att-value="tx_values['webhook_url']"/>
                    <input type="hidden" name="provider_id" t-att-value="tx_values['provider_id']"/>
                    
                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary">
                            Pay with Ebioro
                        </button>
                    </div>
                </form>
                
                <script>
                    console.log('Ebioro payment form initialized');
                    try {
                        const form = document.getElementById('ebioro_payment_form');
                        if (form) {
                            console.log('Form found, submitting...');
                            form.submit();
                        } else {
                            console.error('Ebioro payment form not found!');
                        }
                    } catch (error) {
                        console.error('Error submitting Ebioro payment form:', error);
                    }
                </script>
            </div>
        </xpath>
    </template>
</odoo>
