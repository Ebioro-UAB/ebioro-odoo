<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="redirect_form">
        <form t-att-action="return_url" method="get">
            <field name="name">ebioro.redirect.form</field>
            <field name="model">payment.transaction</field>
            <input type="hidden" name="paymentId" t-att-value="paymentId"/>
            <input type="hidden" name="auth_token" t-att-value="auth_token"/>
            <input type="hidden" name="lang" t-att-value="lang"/>
        </form>
    </template>
</odoo>