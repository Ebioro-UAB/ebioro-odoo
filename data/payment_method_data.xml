<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_method_ebioro_wallet" model="payment.method">
        <!-- Customer-facing label at checkout. The internal `code` stays
             ebioro_wallet (referenced in const.DEFAULT_PAYMENT_METHOD_CODES). -->
        <field name="name">Pay with crypto</field>
        <field name="code">ebioro_wallet</field>
        <field name="sequence">1000</field>
        <field name="active">False</field>
        <field name="image" type="base64" file="payment_ebioro/static/description/icon.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">none</field>
    </record>
</odoo>
